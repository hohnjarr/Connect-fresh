# ── IMAP ──────────────────────────────────────────────────────────────────────
# For Gmail: enable IMAP in Settings → See all settings → Forwarding and POP/IMAP
# Use an App Password if 2-Step Verification is on (myaccount.google.com/apppasswords)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=you@gmail.com
IMAP_PASSWORD=your-app-password-here
IMAP_MAILBOX=INBOX

# ── Filtering ─────────────────────────────────────────────────────────────────
# Emails whose subject *contains* this string (case-insensitive on most servers)
SUBJECT_FILTER=Class Schedule

# How often to check for new emails, in seconds (default: 60)
POLL_INTERVAL_SECONDS=60

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Freshsales CRM ────────────────────────────────────────────────────────────
# Your Freshworks subdomain: https://<FRESHSALES_DOMAIN>.myfreshworks.com/crm/sales
FRESHSALES_DOMAIN=yourcompany
FRESHSALES_API_KEY=your-freshsales-api-key
# API field name of the checkbox field on the Contact (e.g. cf_qualified_student)
FRESHSALES_QUALIFIED_FIELD=cf_qualified_student
